{
  "name": "virtuui-workspace",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "pnpm -r build",
    "typecheck": "node scripts/ensure-built.mjs && pnpm -r typecheck",
    "lint": "eslint . --max-warnings=0",
    "test": "jest --runInBand",
    "test:coverage": "jest --runInBand --coverage",
    "test:artifacts": "node scripts/verify-artifacts.mjs",
    "storybook": "pnpm --filter @virtuui/docs storybook",
    "build:storybook": "pnpm --filter @virtuui/docs build:storybook",
    "check": "pnpm build && pnpm lint && pnpm typecheck && pnpm test && pnpm test:artifacts",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm check && changeset publish",
    "prepare": "husky",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@changesets/cli": "^2.29.0",
    "@eslint/js": "^9.22.0",
    "@playwright/test": "^1.65.0",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.13.0",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "eslint": "^9.22.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.0.0",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "ts-jest": "^29.2.6",
    "tsx": "^4.19.3",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.26.0",
    "vite": "^7.0.0"
  }
}
